# Supabase/Postgres
# 둘 중 하나만 채우면 됩니다. Supabase pooler/connection string을 그대로 넣어도 됩니다.
# 실제 서버 실행 시에는 아래 DB 값 중 하나를 반드시 실제 값으로 채워야 합니다.
# 둘 다 비어 있으면 개발용 SQLite(test.db)로 fallback됩니다.
DATABASE_URL=
SUPABASE_DB_URL=postgresql://postgres:[비밀번호]@[호스트]:5432/postgres
SUPABASE_DB_PASSWORD=your_raw_password
SUPABASE_DB_HOST=db.example.supabase.co


# Hying API
HYING_API_BASE_URL=https://www.h2nbiz.or.kr
HYING_API_KEY=발급받은_API_KEY
HYING_STATIONS_ENDPOINT=/api/chrstnList/operationInfo
HYING_STATION_STATUS_ENDPOINT=/api/chrstnList/currentInfo
HYING_STATION_FACILITIES_ENDPOINT=/api/chrstnList/adiInfo

# Gemini Text-to-SQL
# 둘 중 하나만 채우면 됩니다. GEMINI_API_KEY를 우선 사용합니다.
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=

# Server-side background status sync
HYING_STARTUP_SYNC_ENABLED=true
HYING_STATIONS_SYNC_PAGE_NO=
HYING_STATIONS_SYNC_NUM_OF_ROWS=
HYING_STATUS_SYNC_ENABLED=true
HYING_STATUS_SYNC_INTERVAL_SECONDS=300
HYING_STATUS_SYNC_PAGE_NO=
HYING_STATUS_SYNC_NUM_OF_ROWS=
